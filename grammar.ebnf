(* The lexer supplies one token vector per line. Empty vectors and endline
   tokens are layout, not grammar terminals. Each nonempty vector contains
   exactly one declaration, assignment, or exit. Exit is the final statement. *)
program ::= { statement } exit
statement ::= decl | assign
decl ::= "i32" [ "mut" ] ident "{" expr "}"
assign ::= ident ":=" expr
exit ::= "exit" factor
expr ::= term { ("+" | "-") term }
term ::= factor { "*" factor }
factor ::= number | ident
